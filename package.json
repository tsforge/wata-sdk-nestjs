{
    "name": "@tsforge7/wata-sdk-nestjs",
    "version": "0.1.3",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build"
    ],
    "license": "ISC",
    "description": "wata sdk for nestjs",
    "scripts": {
        "prepublish": "rm -rf build && tsc",
        "prepare": "husky",
        "build": "tsc",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.ts\" \"*.md\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"*.md\"",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tsforge/wata-sdk-nestjs"
    },
    "homepage": "https://github.com/tsforge/wata-sdk-nestjs#readme",
    "bugs": {
        "url": "https://github.com/tsforge/wata-sdk-nestjs/issues"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.0"
    },
    "peerDependencies": {
        "@tsforge7/wata-sdk": ">=0.1.3"
    },
    "author": "tsforge",
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "sdk",
        "typescript",
        "api",
        "client",
        "network",
        "nestjs",
        "wata",
        "wata-sdk",
        "wata-sdk-nestjs",
        "payments",
        "acquiring"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tsforge7/wata-sdk": "^0.1.3",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "husky": "^9.1.7",
        "prettier": "^3.9.6",
        "typescript": "6.0",
        "typescript-eslint": "^8.65.0"
    }
}
